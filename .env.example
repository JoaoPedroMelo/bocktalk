# Postgres (Neon). Sem isso, o app usa um banco em memória (só para testes locais).
DATABASE_URL=

# IA gratuita — configure pelo menos uma. A ordem de tentativa é Groq -> Gemini.
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Quantas questões inéditas a IA gera por partida (as demais vêm do banco).
NEW_QUESTIONS_PER_MATCH=4
